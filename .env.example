# Copy to .env. Never commit .env or put credentials in frontend code.
AIVORA_ENV=development
AIVORA_DATABASE_URL=sqlite:///./data/aivora.db
AIVORA_ORIGIN=http://127.0.0.1:8090
AIVORA_ALLOW_SIGNUP=true
# extractive works offline and quotes retrieved passages; it is not an LLM.
# Cloud options: groq or gemini. Set the model explicitly for your account.
AIVORA_PROVIDER=extractive
AIVORA_MODEL=
GROQ_API_KEY=
GOOGLE_API_KEY=
AIVORA_COOKIE_SECURE=false
AIVORA_DAILY_REQUEST_LIMIT=100
# optional multilingual local reranking, downloads model on first use
AIVORA_SEMANTIC_MODEL=
